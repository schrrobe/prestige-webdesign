  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Oxblood pill with arrow; the one action per block.",
      "html": "<a class=\"ds-btn ds-btn-primary\" href=\"#\">Erstgespräch anfragen <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>",
      "css": ".ds-btn{display:inline-flex;min-height:48px;align-items:center;justify-content:center;gap:10px;white-space:nowrap;border-radius:9999px;border:1px solid;padding:10px 24px;font-family:'Schibsted Grotesk Variable','Schibsted Grotesk',system-ui,sans-serif;font-size:0.9375rem;font-weight:600;text-decoration:none;transition:color .2s,background-color .2s,border-color .2s}.ds-btn>svg{transition:transform .2s cubic-bezier(0.16,1,0.3,1)}.ds-btn:hover>svg{transform:translateX(3px)}.ds-btn:focus-visible{outline:2px solid #161616;outline-offset:3px}.ds-btn-primary{border-color:#7a1f2b;background:#7a1f2b;color:#fff}.ds-btn-primary:hover{border-color:#5c1520;background:#5c1520;color:#fff}"
    },
    {
      "name": "Dark Button",
      "kind": "button",
      "refersTo": "button-dark",
      "description": "Ink pill for the secondary action.",
      "html": "<a class=\"ds-btn ds-btn-dark\" href=\"#\">Zur Fallstudie <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></a>",
      "css": ".ds-btn{display:inline-flex;min-height:48px;align-items:center;gap:10px;border-radius:9999px;border:1px solid;padding:10px 24px;font-family:'Schibsted Grotesk Variable',system-ui,sans-serif;font-size:0.9375rem;font-weight:600;text-decoration:none;transition:color .2s,background-color .2s}.ds-btn>svg{transition:transform .2s cubic-bezier(0.16,1,0.3,1)}.ds-btn:hover>svg{transform:translateX(3px)}.ds-btn-dark{border-color:#161616;background:#161616;color:#fbfbfa}.ds-btn-dark:hover{background:transparent;color:#161616}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Line-bordered pill for the alternative choice.",
      "html": "<button class=\"ds-btn ds-btn-outline\" type=\"button\">Ablehnen</button>",
      "css": ".ds-btn{display:inline-flex;min-height:48px;align-items:center;border-radius:9999px;border:1px solid;padding:10px 24px;font-family:'Schibsted Grotesk Variable',system-ui,sans-serif;font-size:0.9375rem;font-weight:600;transition:border-color .2s}.ds-btn-outline{border-color:#8a857f;background:transparent;color:#161616}.ds-btn-outline:hover{border-color:#161616}.ds-btn:focus-visible{outline:2px solid #161616;outline-offset:3px}"
    },
    {
      "name": "Underlined Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Email field: underline only; ink on focus.",
      "html": "<label class=\"ds-field-label\" for=\"ds-email\">Ihre E-Mail-Adresse</label><input id=\"ds-email\" class=\"ds-input\" type=\"email\" placeholder=\"name@firma.de\">",
      "css": ".ds-field-label{display:block;margin-bottom:4px;font-family:'Schibsted Grotesk Variable',system-ui,sans-serif;font-size:0.9375rem;font-weight:600;color:#161616}.ds-input{display:block;width:100%;min-height:48px;border:0;border-bottom:1.5px solid #8a857f;border-radius:0;background:transparent;padding:12px 0;font-family:'Schibsted Grotesk Variable',system-ui,sans-serif;font-size:1.125rem;color:#161616;transition:border-color .15s}.ds-input::placeholder{color:#5a5652;opacity:1}.ds-input:hover{border-color:#5a5652}.ds-input:focus{border-color:#161616;outline:none}.ds-input:focus-visible{outline:2px solid #161616;outline-offset:4px}"
    },
    {
      "name": "Topic Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Radio chip for the inquiry topic; checked fills ink.",
      "html": "<div class=\"ds-chips\"><label class=\"ds-chip\"><input type=\"radio\" name=\"t\" checked>Neue Website</label><label class=\"ds-chip\"><input type=\"radio\" name=\"t\">Relaunch</label></div>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:8px}.ds-chip{display:inline-flex;min-height:44px;align-items:center;cursor:pointer;border:1px solid #8a857f;border-radius:9999px;padding:8px 16px;font-family:'Schibsted Grotesk Variable',system-ui,sans-serif;font-size:0.9375rem;font-weight:500;color:#161616;transition:border-color .15s,background-color .15s}.ds-chip input{position:absolute;opacity:0;width:1px;height:1px}.ds-chip:hover{border-color:#161616}.ds-chip:has(input:checked){border-color:#161616;background:#161616;color:#fbfbfa}.ds-chip:has(input:focus-visible){outline:2px solid #161616;outline-offset:3px}"
    },
    {
      "name": "Section Head",
      "kind": "custom",
      "refersTo": "headline",
      "description": "Full-ink top rule, serif H2 with one italic oxblood word, soft lead.",
      "html": "<div class=\"ds-head\"><h2 class=\"ds-headline\">Was es kostet – <em>vorher</em>, nicht hinterher.</h2><p class=\"ds-lead\">Festpreise, bevor es losgeht.</p></div>",
      "css": ".ds-head{border-top:1px solid #161616;padding-top:40px;max-width:48rem}.ds-headline{margin:0;font-family:'Bodoni Moda Variable','Bodoni Moda',Didot,Georgia,serif;font-size:3rem;font-weight:500;font-variation-settings:'opsz' 72;line-height:1.06;letter-spacing:-0.018em;color:#161616}.ds-headline em{font-style:italic;color:#7a1f2b}.ds-lead{margin:20px 0 0;max-width:42rem;font-family:'Schibsted Grotesk Variable',system-ui,sans-serif;font-size:1.25rem;line-height:1.625;color:#5a5652}"
    },
    {
      "name": "Service Row",
      "kind": "custom",
      "refersTo": "panel",
      "description": "Ruled price-table row: serif name, soft description, tabular price, oxblood arrow.",
      "html": "<a class=\"ds-row\" href=\"#\"><span class=\"ds-row-name\">Webdesign</span><span class=\"ds-row-desc\">Die Website für Ihren Betrieb.</span><span class=\"ds-row-price\">ab 800 €</span></a>",
      "css": ".ds-row{display:grid;grid-template-columns:30% 1fr auto;gap:32px;align-items:start;padding:32px 8px;border-bottom:1px solid #dcd8d2;border-top:1px solid #161616;color:#161616;text-decoration:none;font-family:'Schibsted Grotesk Variable',system-ui,sans-serif;transition:background-color .2s}.ds-row:hover{background:rgb(239 236 231 / .6)}.ds-row-name{font-family:'Bodoni Moda Variable',Didot,Georgia,serif;font-size:2rem;font-weight:500;font-variation-settings:'opsz' 48;line-height:1}.ds-row-desc{color:#5a5652}.ds-row-price{font-size:1.25rem;font-weight:600;font-variant-numeric:tabular-nums lining-nums;white-space:nowrap}"
    },
    {
      "name": "Lead Shots",
      "kind": "custom",
      "refersTo": "rounded.phone",
