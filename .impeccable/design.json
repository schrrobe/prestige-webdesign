  "narrative": {
    "northStar": "The Well-Made Magazine",
    "overview": "A quiet editorial page: tall optical-size serif headlines, generous white, strong screenshots captioned beneath, sober grotesk text. Hierarchy is carried by type scale, 1px rules and air, never by boxes, icons or effects. One colour, oxblood, marks what can be done and at most one italic word per view. Light by default with a full dark mode; the footer sits on ink, the closing inquiry on deep oxblood.\n\nNo theme and no metaphor: not a stadium, not a building plan, no Revier costume. It reads high-end through restraint: real work, open prices, one contact person.",
    "keyCharacteristics": [
      "Bodoni Moda 500 with opsz against Schibsted Grotesk",
      "Cool paper, ink, stone alternation; oxblood the only hue",
      "Full-ink top rule per block, hair dividers between rows",
      "Pill buttons with arrow nudge; underlined fields",
      "One motion moment: clip-path reveal of the lead image"
    ],
    "rules": [
      {
        "name": "The One Colour Rule",
        "body": "Oxblood means act here: actions (primary pill, link underline, arrow affordance, active nav) and at most one italic accent word per view. Never a fill, border or decorative tint.",
        "section": "colors"
      },
      {
        "name": "The Token Flip Rule",
        "body": "Dark surfaces re-declare tokens locally (.on-ink, .on-accent); components never hard-code colours.",
        "section": "colors"
      },
      {
        "name": "The Optical Size Rule",
        "body": "Every serif setting declares opsz, scaled to size: 96, 72, 48, 36, 28.",
        "section": "typography"
      },
      {
        "name": "The Single Italic Rule",
        "body": "Italic oxblood is reserved for one <em> in a display or headline per viewport; on ink and oxblood surfaces it keeps the italic and drops the colour.",
        "section": "typography"
      },
      {
        "name": "The Rule-Not-Box Rule",
        "body": "Blocks open with a 1px full-ink rule and divide rows with hair; content is not boxed in cards.",
        "section": "layout"
      },
      {
        "name": "The Real Shadow Rule",
        "body": "A shadow means this sits above the page: the overlapping phone, the dropdown, the consent banner. Nothing else.",
        "section": "elevation"
